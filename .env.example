# SMARTQUALIHOME Environment Configuration
# Copy this file to .env and fill in your actual values

# Flask Configuration
SECRET_KEY=your-secret-key-change-this-in-production

# Database Configuration
# Use SQLite (development, default):
DB_USE_SQLITE=true

# OR use MySQL (production):
# DB_USE_SQLITE=false
# DB_HOST=your-database-host
# DB_PORT=3306
# DB_USER=your-database-user
# DB_PASSWORD=your-database-password
# DB_NAME=smartqualihome

# File Upload Configuration
# UPLOAD_FOLDER=instance/uploads  # Default is ./instance/uploads

# SMTP Email Configuration (for password reset feature)
# Leave empty to disable password reset emails (fallback mode with manual reset link)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_FROM=noreply@qualihome.local

# Session Configuration (minutes)
SESSION_TIMEOUT_MINS=60

# Security Configuration
MAX_LOGIN_ATTEMPTS=5
MAX_FORGOT_PASSWORD_ATTEMPTS=5
MIN_PASSWORD_LENGTH=8

# Railway Deployment (do not change port - Railway sets it)
# PORT is automatically set by Railway based on PORT environment variable
